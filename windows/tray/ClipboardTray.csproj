<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ClipboardTray</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\ClipLink.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon only brands the .exe file; the tray icon and window
         icons load this embedded copy at runtime (see AppIcon.cs). -->
    <EmbeddedResource Include="..\ClipLink.ico" LogicalName="ClipLink.ico" />
  </ItemGroup>

</Project>
