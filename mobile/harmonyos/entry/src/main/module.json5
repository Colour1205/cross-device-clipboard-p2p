{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // Per uiMaterial's own reference doc: in the default mode, Navigation/
    // NavDestination title bars do NOT get immersive material
    // automatically - only specific popup/dialog components do. "enable"
    // turns it on by default for Navigation/NavDestination (among others)
    // so their native title bar and back button get the effect without
    // any manual systemMaterial() call on custom-built replacement
    // widgets - the native rendering handles correct positioning/safe-area
    // clearance for free, which repeated attempts at a custom title
    // builder could not reliably reproduce.
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        // Normal/system_grant permission (confirmed against the official
        // permission reference) - unlike READ_PASTEBOARD, this is safe to
        // just declare: no ACL/AppGallery restricted-permission process,
        // no runtime user dialog. Needed for the long-press menu's
        // hapticFeedbackMode - see syncedItemCard's bindContextMenu.
        "name": "ohos.permission.VIBRATE"
      },
      {
        // Normal/system_grant. Lets the Me screen list this device's own
        // IP addresses (connection.getConnectionPropertiesSync).
        "name": "ohos.permission.GET_NETWORK_INFO"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}