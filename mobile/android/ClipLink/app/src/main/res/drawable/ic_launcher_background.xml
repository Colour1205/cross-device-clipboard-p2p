<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background. Flat, full-bleed: the launcher masks this to
     whatever shape the device uses. The colour is the average of the icon
     artwork's own edge (mipmap-*/ic_launcher_foreground.png), so the seam
     between the two layers doesn't show where the launcher's mask or
     parallax reveals it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#7D6758"
        android:pathData="M0,0h108v108h-108z" />
</vector>
