<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon (monochrome) layer: two overlapping rounded squares, the
     same two-card shape as the full-colour icon artwork in
     mipmap-*/ic_launcher_foreground.png, which can't serve as a monochrome
     layer itself (the system only uses a layer's alpha, and the artwork is
     an opaque square).

     Everything sits inside the 72x72 safe zone centred in the 108x108 canvas
     (18dp margin on every side); a launcher mask can clip anything outside it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back sheet: offset up-left, dimmed to read as "the other device". -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45"
        android:pathData="M36,30 h26 a8,8 0 0,1 8,8 v26 a8,8 0 0,1 -8,8 h-26 a8,8 0 0,1 -8,-8 v-26 a8,8 0 0,1 8,-8 z" />

    <!-- Front sheet, knocked out of the back one by the gap the stroke leaves. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,40 h26 a8,8 0 0,1 8,8 v26 a8,8 0 0,1 -8,8 h-26 a8,8 0 0,1 -8,-8 v-26 a8,8 0 0,1 8,-8 z" />

    <!-- The clip tab on the front sheet. -->
    <path
        android:fillColor="#3B5BFE"
        android:pathData="M54,36 h10 a3,3 0 0,1 3,3 v4 a3,3 0 0,1 -3,3 h-10 a3,3 0 0,1 -3,-3 v-4 a3,3 0 0,1 3,-3 z" />

    <!-- Two content lines. -->
    <path
        android:fillColor="#3B5BFE"
        android:pathData="M48,56 h22 a2.5,2.5 0 0,1 0,5 h-22 a2.5,2.5 0 0,1 0,-5 z" />
    <path
        android:fillColor="#3B5BFE"
        android:pathData="M48,66 h14 a2.5,2.5 0 0,1 0,5 h-14 a2.5,2.5 0 0,1 0,-5 z" />
</vector>
